# ==============================================================================
# Streaming Voice Translation Pipeline - Environment Configuration
# ==============================================================================

# Gateway Configuration
GATEWAY_PORT=8443
GATEWAY_HOST=0.0.0.0
MAX_BUFFERED_BYTES=65536

# STT Service Configuration
STT_HOST=0.0.0.0
STT_PORT=8001
# Primary Engine: 'sherpa-onnx' (Ultra-fast CPU non-autoregressive) | 'faster-whisper'
STT_ENGINE=sherpa-onnx

# Sherpa-ONNX Model Type:
#   'sense-voice'  : Multilingual (EN + JA), ~40-60ms CPU latency, built-in ITN
#   'parakeet-ctc' : NVIDIA NeMo Conformer-CTC (English), ~90ms CPU latency
SHERPA_MODEL=sense-voice
SHERPA_CPU_THREADS=4
SHERPA_MODELS_DIR=services/stt/models

# Faster-Whisper Fallback Configuration (used when STT_ENGINE=faster-whisper)
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4

# Acoustic VAD & Segmentation Settings
VAD_THRESHOLD=0.5
HANGOVER_MS=900
PREROLL_MS=300
MAX_LEN_MS=18000
LOCAL_AGREEMENT_N=2
MIN_CHUNK_MS=500

# MT Service Configuration (vLLM)
MT_HOST=0.0.0.0
MT_PORT=8002
MT_MODEL=Qwen/Qwen2.5-7B-Instruct
MT_GPU_MEMORY_UTILIZATION=0.85
MT_MAX_NUM_SEQS=64
MT_DTYPE=float16
MT_DEVICE=cuda

# Inter-Service URLs (Docker internal network or localhost)
STT_SERVICE_URL=ws://stt-service:8001/stream
MT_SERVICE_URL=http://mt-service:8002/translate
TTS_SERVICE_URL=http://tts-service:8003/synthesize

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Security Settings --------------------------------------------------------
# [C3] CORS: Restrict data API to your reviewer dashboard origin. Use '*' only for dev.
CORS_ORIGIN=http://localhost:5173

# [C1/C2] Gateway: Maximum concurrent WebSocket sessions (protects against DoS)
MAX_SESSIONS=500

# [M1] Gateway: Close sessions idle longer than this many milliseconds (30 min default)
SESSION_IDLE_TIMEOUT_MS=1800000

# [C4] Agent: Maximum concurrent in-memory sessions
MAX_AGENT_SESSIONS=500

# [C4/M1] Agent: Evict sessions older than this many milliseconds (1 hour default)
AGENT_SESSION_TTL_MS=3600000

# [H2] Agent: Maximum characters allowed in a single caller utterance sent to LLM
# (Enforced in BrainRequest Pydantic schema; this is for documentation only)
AGENT_MAX_TEXT_LEN=2000

# Agent conversation brain (selectable per call in the UI: Template / Local Qwen / OpenAI)
# Local provider: Ollama OpenAI-compatible endpoint (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENT_LOCAL_MODEL=qwen3:1.7b
# Paid provider: OpenAI API (unset = OpenAI option falls back to templates)
# OPENAI_API_KEY=sk-...
AGENT_LLM_MODEL=gpt-4o-mini
